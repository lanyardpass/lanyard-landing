---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE, APP_STORE_ID, APP_STORE_URL } from '@/data/site';

interface Props {
  title?: string;
  description?: string;
  /** WIP branch deploys are auto-noindexed by Netlify; this is an extra belt. */
  noindex?: boolean;
  /** Absolute URL to override the sitewide social card (e.g. a guide's hero). */
  ogImage?: string;
  /**
   * Opt this page into client-side routing + view transitions (guides and
   * details surfaces). Navigations between two opted-in pages morph/crossfade;
   * links to non-opted pages fall back to normal full loads. Any page setting
   * this MUST register its per-page scripts via onPageReady (src/lib/vt.ts) —
   * module scripts do not re-run after a client-side swap.
   */
  viewTransitions?: boolean;
}

const {
  title = `${SITE.name} — Your Annual Pass Companion`,
  description = SITE.description,
  ogImage: ogImageOverride,
  // Non-production build contexts set PUBLIC_NOINDEX=true (see netlify.toml).
  // The most-recent branch deploy is otherwise indexable by default, so this
  // keeps WIP out of search engines while production stays indexable.
  noindex = import.meta.env.PUBLIC_NOINDEX === 'true',
  viewTransitions = false,
} = Astro.props;

// Launch link-preview card sitewide (built by scripts/og.html ?v=launch).
// A page can override it (a guide passes its hero) via the `ogImage` prop.
const ogImage = ogImageOverride ?? new URL('/og-image.png?v=2', Astro.site).href;

// Canonical URL for this page — strips query strings (e.g. ?src=reddit) so
// channel-tagged inbound links consolidate to one URL instead of splitting
// ranking signals. Drives both <link rel=canonical> and og:url.
//
// Normalize the path to the slashless, extensionless canonical form: with
// `build.format: 'file'` Astro.url.pathname comes through as `/beta.html`, and a
// trailing slash can sneak in too — strip both so the canonical is always
// `/beta` (never `/beta.html` or `/beta/`). Root stays `/`. Since Astro 7 the
// home page's pathname arrives as `/index.html` (v5 gave `/`), so strip a
// trailing `/index` segment too or the root canonical becomes `/index`.
const cleanPath = Astro.url.pathname
  .replace(/\.html$/, '')
  .replace(/\/index$/, '/')
  .replace(/\/+$/, '') || '/';
const canonical = new URL(cleanPath, Astro.site).href;

// Structured data: tells search engines this site is an iOS app, not a blog.
// Category is Travel (theme-park vertical — same neighborhood as the official
// Disney/Universal apps + Touring Plans), with a free offer. NO aggregateRating
// until there are real App Store ratings — faking review markup is a Google
// penalty. downloadUrl/installUrl light up once APP_STORE_ID is filled;
// aggregateRating stays out until real ratings exist.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'TravelApplication',
  name: SITE.name,
  applicationCategory: 'TravelApplication',
  operatingSystem: 'iOS',
  description: SITE.description,
  url: new URL('/', Astro.site).href,
  image: ogImage,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: SITE.name, url: new URL('/', Astro.site).href },
  ...(APP_STORE_ID ? { downloadUrl: APP_STORE_URL, installUrl: APP_STORE_URL } : {}),
  // REAL App Store numbers (5.0 across 5 US ratings as of 2026-07-26) — this
  // field stayed out until genuine ratings existed (fabricated review markup
  // is a Google penalty). MAINTENANCE: hand-updated; refresh alongside release
  // marketing passes so it never drifts far from the store.
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '5', ratingCount: '5' },
};

// TelemetryDeck "Lanyard Web" app (privacy-first, cookieless, no IP storage).
// LIVE signals come ONLY from the production host — every other hostname is
// test-flagged at runtime in the loader below. This closes the gap the
// enumerate-the-test-contexts approach left open: Netlify deploy PERMALINKS
// of production builds (<deploy-id>--site.netlify.app) carry no
// PUBLIC_NOINDEX and aren't localhost, so they leaked live signals (verified
// via TQL 2026-07-02: 4 permalink pageviews in live data; localhost + branch
// deploys were correctly flagged). PUBLIC_NOINDEX stays as the build-time
// belt. The appID is public by design (it ships in the client).
const TD_APP_ID = '155A1765-42BE-4F22-B380-691BB80566D5';
const tdTestMode = import.meta.env.PUBLIC_NOINDEX === 'true';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {/* Smart App Banner — mobile Safari shows an inline "open in App Store"
        strip on every page. Renders only once APP_STORE_ID is filled. */}
    {APP_STORE_ID && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}

    {/* PNG (not SVG) on purpose: Google rasterizes SVG favicons poorly — the
        inset-with-ring SERP rendering seen 2026-06-11. Full-bleed circle
        artwork fills Google's circular chip (Reddit pattern). Master:
        brand/favicon_serp_v1.svg via tools/build-favicon.py. */}
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    {/* iOS home-screen pin gets the LY app icon (labels-off legibility). */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lanyard — watch your pass pay for itself" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />

    <Font cssVariable="--font-montserrat" preload />

    {viewTransitions && <ClientRouter />}
    {viewTransitions && (
      <style is:global>
        /* House transition speed — 0.5s (Dan's call, 2026-07-26): the browser's
           0.25s default read as too quick for the card→hero morph to register.
           EVERY layer must share the clock — group (position/size), image-pair,
           and the old/new snapshots' crossfade. Covering only the group leaves
           the inner crossfade at the 0.25s default, so the destination's
           rounded corners land mid-glide and pop (seen on review). */
        ::view-transition-group(*),
        ::view-transition-image-pair(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation-duration: 0.5s;
        }
      </style>
    )}

    {/* Privacy-first web analytics. Fires one pageView per load; ?src=… rides
        in the URL for channel attribution. Excluded from /admin (own layout).
        Injected at runtime so test mode can be decided by HOSTNAME (see the
        frontmatter comment): production host → live, anything else → test. */}
    <script is:inline define:vars={{ TD_APP_ID, tdTestMode, PROD_HOST: SITE.domain }}>
      const td = document.createElement('script');
      td.src = 'https://cdn.telemetrydeck.com/websdk/telemetrydeck.min.js';
      td.dataset.appId = TD_APP_ID;
      if (tdTestMode || window.location.hostname !== PROD_HOST) td.dataset.isTestMode = 'true';
      document.head.appendChild(td);
    </script>

    <script>
      // SPA pageviews under the ClientRouter. The websdk above fires its one
      // pageView on the initial full load; each client-side navigation after
      // that sends an identical pageView via the shim (spaPageView docs that
      // contract). astro:page-load never fires without the router, so this is
      // inert on plain MPA pages — and its first firing (initial load) is
      // skipped because the websdk already covered it.
      import { spaPageView } from '@/lib/telemetry';
      let prev: string | null = null;
      document.addEventListener('astro:page-load', () => {
        if (prev !== null) spaPageView(prev);
        prev = window.location.href;
      });
    </script>

    {/* Per-page <head> extras (e.g. a guide's Article + FAQPage JSON-LD). */}
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
