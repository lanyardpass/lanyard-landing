---
// GuideLayout — the shell every guide composes into: SEO head (canonical via
// Layout, Article + FAQPage JSON-LD here), hero, answer box, sticky TOC +
// article body (passed in as the default slot), FAQ accordion, CTA, related.
// Content stays in the MDX; this is pure assembly + structure.
import type { MarkdownHeading, ImageMetadata } from 'astro';
import Layout from '@/layouts/Layout.astro';
import GuideHero from '@/components/guides/GuideHero.astro';
import AnswerBox from '@/components/guides/AnswerBox.astro';
import TableOfContents from '@/components/guides/TableOfContents.astro';
import FAQAccordion from '@/components/guides/FAQAccordion.astro';
import GuideCTA from '@/components/guides/GuideCTA.astro';
import RelatedGuides from '@/components/guides/RelatedGuides.astro';
import { SITE } from '@/data/site';
import '@/styles/guides.css';

interface FaqItem { question: string; answer: string; }
interface RelatedItem { title: string; href: string; dek?: string; }

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  dek: string;
  answer: string;
  byline: string;
  lastVerified: Date;
  published?: Date;
  hero: ImageMetadata;
  heroAlt: string;
  ogImage?: ImageMetadata;
  faq: FaqItem[];
  headings: MarkdownHeading[];
  readingTime: number;
  related?: RelatedItem[];
  ctaHeading?: string;
  ctaBody?: string;
  /** Draft guides only render on non-production builds; they carry noindex + a banner. */
  draft?: boolean;
}

const {
  title, seoTitle, description, dek, answer, byline,
  lastVerified, published, hero, heroAlt, ogImage,
  faq, headings, readingTime, related = [], ctaHeading, ctaBody, draft = false,
} = Astro.props;

const pageTitle = seoTitle ?? `${title} | ${SITE.name}`;
// Same normalization as Layout.astro — including the Astro 7 `/index` strip.
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/').replace(/\/+$/, '') || '/', Astro.site).href;
const ogAbs = new URL((ogImage ?? hero).src, Astro.site).href;

// Article schema — dates drive "freshness" signals; author + publisher named.
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: ogAbs,
  datePublished: (published ?? lastVerified).toISOString(),
  dateModified: lastVerified.toISOString(),
  author: { '@type': 'Person', name: 'Dan Seals' },
  publisher: { '@type': 'Organization', name: SITE.name, url: new URL('/', Astro.site).href },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
};

// FAQPage schema — same array the accordion renders, so they never drift.
const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
---
<Layout title={pageTitle} description={description} ogImage={ogAbs} viewTransitions>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <article class="guide-page">
    {draft && (
      <p class="guide-draftbar">DRAFT — visible on preview deploys only, never on lanyardpass.com</p>
    )}
    <GuideHero
      title={title}
      dek={dek}
      byline={byline}
      readingTime={readingTime}
      lastVerified={lastVerified}
      hero={hero}
      heroAlt={heroAlt}
    />

    <div class="guide-answer-wrap">
      <AnswerBox text={answer} />
    </div>

    <div class="guide-shell">
      <aside class="guide-shell__rail">
        <TableOfContents headings={headings} />
      </aside>

      <div class="guide-article">
        <div class="guide-prose">
          <slot />
        </div>

        <FAQAccordion faq={faq} />
        <RelatedGuides items={related} />
      </div>
    </div>

    <div class="guide-cta-wrap">
      <GuideCTA heading={ctaHeading} body={ctaBody} />
    </div>
  </article>

  <script>
    // Reveal-on-scroll for every [data-reveal] block (Figure, ScrollReveal,
    // InViewVideoLoop). One lazy observer for the whole session; each pageview
    // (initial or client-side swap) observes that page's fresh elements.
    // Reduced-motion users get everything shown immediately (handled in each
    // component's CSS), so we still mark them in-view here as a belt-and-braces.
    import { onPageReady } from '@/lib/vt';
    let io: IntersectionObserver | null = null;
    onPageReady(() => {
      const reveals = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)'));
      if (!reveals.length) return;
      io ??= new IntersectionObserver(
        (entries, obs) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); obs.unobserve(e.target); }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
      );
      reveals.forEach((el) => io!.observe(el));
    });
  </script>

  <script>
    // Read-depth + dwell telemetry (anonymous, aggregate, matches the site's
    // privacy posture). Answers "do people actually read the guide, and how far."
    // Per-PAGE state (guide slug, milestones, dwell clock) lives in `page` and
    // is rebuilt on every pageview; window/document listeners are wired once
    // per session. Under the ClientRouter, navigating away flushes the dwell
    // (astro:before-preparation) exactly like a pagehide would.
    import { track } from '@/lib/telemetry';
    import { onPageReady } from '@/lib/vt';

    let page: { guide: string; hit: Set<number>; start: number; sent: boolean } | null = null;

    function checkDepth() {
      if (!page) return;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return;
      const pct = Math.min(100, Math.round((window.scrollY / scrollable) * 100));
      for (const m of [25, 50, 75, 100]) {
        if (pct >= m && !page.hit.has(m)) { page.hit.add(m); track('Guide.Read', { guide: page.guide, depth: String(m) }); }
      }
    }

    // Best-effort dwell bucket, sent when the tab is hidden/closed or the
    // reader client-routes away. Approximate (on-exit sends aren't guaranteed),
    // so lean on Guide.Read for read-through.
    function sendDwell() {
      if (!page || page.sent) return;
      page.sent = true;
      const s = Math.round((performance.now() - page.start) / 1000);
      const bucket = s < 15 ? '0-15s' : s < 60 ? '15-60s' : s < 180 ? '1-3m' : s < 360 ? '3-6m' : '6m+';
      track('Guide.Dwell', { guide: page.guide, bucket });
    }

    let wired = false;
    onPageReady(() => {
      page = {
        guide: location.pathname.match(/\/guides\/([^/]+)/)?.[1] || 'guides',
        hit: new Set<number>(),
        start: performance.now(),
        sent: false,
      };
      if (!wired) {
        wired = true;
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) { ticking = true; requestAnimationFrame(() => { checkDepth(); ticking = false; }); }
        }, { passive: true });
        document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') sendDwell(); });
        window.addEventListener('pagehide', sendDwell);
        document.addEventListener('astro:before-preparation', sendDwell);
      }
      checkDepth();
    });
  </script>
</Layout>

<style>
  /* Draft banner (preview deploys only) — same treatment as the blog's. */
  .guide-draftbar {
    margin: 0; padding: 0.5rem var(--gutter); text-align: center;
    background: rgba(240, 200, 90, 0.18); color: #8a6410;
    border-bottom: 1px dashed rgba(180, 130, 20, 0.45);
    font-size: 0.78rem; font-weight: 800; letter-spacing: 0.05em;
  }
  .guide-answer-wrap {
    max-width: 44rem; margin-inline: auto;
    padding: 0 var(--gutter); margin-top: clamp(1.2rem, 3vw, 1.8rem);
  }
  /* On mobile the rail stacks above the article as an inline TOC card (the
     TableOfContents component styles itself for that); on desktop the rail
     itself is sticky so the TOC tracks the reader. Sticky must live on the grid
     ITEM (its containing block is the tall .guide-shell), not on the inner TOC
     (whose containing block would be this short rail, leaving no room to move). */
  .guide-shell__rail { min-width: 0; }
  @media (min-width: 960px) {
    /* z-index below the full-bleed wide media (z-index:2 in guides.css), so a
       full-width banner flows OVER the TOC while it's on screen. */
    .guide-shell__rail { position: sticky; top: 5.5rem; align-self: start; z-index: 1; }
  }
  .guide-cta-wrap { max-width: var(--maxw); margin-inline: auto; padding: 0 var(--gutter) clamp(3rem, 7vw, 5rem); }
</style>
