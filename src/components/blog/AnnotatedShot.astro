---
// AnnotatedShot — a still (usually an app screenshot) with numbered pins that
// open short notes. The web equivalent of pointing at the screen while you
// talk. Pins are positioned in percent of the frame so they survive responsive
// scaling; notes list below the image so they're never color/hover-alone.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Pin {
  /** Percent from left, 0–100. */
  x: number;
  /** Percent from top, 0–100. */
  y: number;
  note: string;
}
interface Props {
  src: ImageMetadata;
  alt: string;
  pins: Pin[];
  caption?: string;
  /** Cap the rendered width (phone screenshots shouldn't span the column). */
  maxWidth?: string;
}
const { src, alt, pins, caption, maxWidth = '24rem' } = Astro.props;
---
<figure class="ashot" data-reveal>
  <div class="ashot__frame" style={`max-width: ${maxWidth};`} data-ashot>
    <Image src={src} alt={alt} widths={[480, 800, 1200]} sizes={maxWidth} loading="lazy" class="ashot__img" />
    {pins.map((p, i) => (
      <button
        class="ashot__pin"
        style={`left: ${p.x}%; top: ${p.y}%;`}
        data-pin={i}
        aria-label={`Note ${i + 1}: ${p.note}`}
      >{i + 1}</button>
    ))}
  </div>
  <ol class="ashot__notes">
    {pins.map((p, i) => <li data-note={i}>{p.note}</li>)}
  </ol>
  {caption && <figcaption class="ashot__cap">{caption}</figcaption>}
</figure>

<script>
  // Tapping a pin highlights its note (and vice-versa on note hover). Purely
  // additive — the numbered list already carries the content without JS.
  for (const root of document.querySelectorAll<HTMLElement>('[data-ashot]')) {
    const fig = root.closest('.ashot')!;
    const notes = Array.from(fig.querySelectorAll<HTMLElement>('[data-note]'));
    for (const pin of root.querySelectorAll<HTMLElement>('[data-pin]')) {
      pin.addEventListener('click', () => {
        const i = pin.dataset.pin;
        notes.forEach((n) => n.classList.toggle('is-hot', n.dataset.note === i));
        notes.find((n) => n.dataset.note === i)?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      });
    }
  }
</script>

<style>
  .ashot { margin: 2.2rem 0; }
  .ashot__frame {
    position: relative; margin-inline: auto;
    border-radius: var(--radius); overflow: hidden;
    box-shadow: var(--shadow-card);
  }
  .ashot__frame :global(.ashot__img) { width: 100%; height: auto; display: block; }
  .ashot__pin {
    position: absolute; transform: translate(-50%, -50%);
    width: 1.7rem; height: 1.7rem; border-radius: 50%;
    border: 2px solid #fff; background: var(--green-primary); color: #fff;
    font-size: 0.8rem; font-weight: 800; cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s ease;
  }
  .ashot__pin:hover { transform: translate(-50%, -50%) scale(1.15); }
  .ashot__notes {
    max-width: 32rem; margin: 1rem auto 0; padding-left: 1.4rem;
    font-size: 0.9rem; color: var(--muted); line-height: 1.55;
  }
  .ashot__notes li { margin: 0.35rem 0; padding: 0.15rem 0.4rem; border-radius: 6px; }
  .ashot__notes li::marker { color: var(--green-primary); font-weight: 700; }
  .ashot__notes li.is-hot { background: rgba(82, 183, 136, 0.16); color: var(--ink); }
  .ashot__cap {
    margin-top: 0.6rem; font-size: 0.82rem; color: var(--muted);
    line-height: 1.5; text-align: center;
  }

  .ashot[data-reveal] { opacity: 0; transform: translateY(14px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .ashot[data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .ashot[data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>
