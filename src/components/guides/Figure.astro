---
// Figure — a section still with optional caption. astro:assets gives responsive
// WebP/AVIF; the image fades up on scroll (data-reveal, observed by GuideLayout)
// and honors reduced-motion. Options:
//   wide      — break out to a full-width banner (the 16:9 Isle of Berk panorama)
//   kenBurns  — slow zoom drift
//   parallax  — image drifts slower than the scroll (needs a fixed `ratio` so the
//               frame can crop the overscan; reduced-motion → static cover)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import KenBurnsImage from './KenBurnsImage.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  wide?: boolean;
  kenBurns?: boolean;
  parallax?: boolean;
  /** CSS aspect-ratio for the frame, e.g. "16 / 9". Required for parallax. */
  ratio?: string;
  /** Small inline figure the prose wraps around (desktop only — mobile
   * unfloats to a centered small figure). For casual snapshots that don't
   * deserve a full column. Mutually exclusive with wide/parallax. */
  float?: 'left' | 'right';
  /** Click-to-enlarge. The frame becomes a button that opens the same image
   * full-size in a native <dialog> (Esc / backdrop / × close). For figures
   * whose detail matters at column width — a share card floated at 14rem. */
  lightbox?: boolean;
}
const { src, alt, caption, wide = false, kenBurns = false, parallax = false, ratio, float, lightbox = false } = Astro.props;
// Parallax needs a defined frame height to crop the overscan; default to 16:9.
const effectiveRatio = ratio ?? (parallax ? '16 / 9' : undefined);
const frameStyle = effectiveRatio ? `aspect-ratio: ${effectiveRatio};` : '';
const sizes = wide ? '100vw' : '(min-width: 960px) 700px, 100vw';
const widths = [480, 800, 1200, 1600, 2000];
---
<figure
  class:list={[
    'guide-figure',
    {
      'guide-figure--wide': wide,
      'guide-figure--parallax': parallax,
      'guide-figure--float': !!float,
      'guide-figure--float-left': float === 'left',
      'guide-figure--float-right': float === 'right',
    },
  ]}
  data-reveal
>
  {lightbox ? (
    <button type="button" class="guide-figure__frame guide-figure__zoom" style={frameStyle} data-lb-open aria-label={`View full size: ${alt}`}>
      <Image src={src} alt={alt} widths={widths} sizes={sizes} loading="lazy" class="guide-figure__img" />
    </button>
  ) : (
  <div class="guide-figure__frame" style={frameStyle}>
    {parallax ? (
      <Image
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading="lazy"
        class="guide-figure__img guide-figure__img--parallax"
        data-parallax
      />
    ) : kenBurns ? (
      <KenBurnsImage src={src} alt={alt} sizes={sizes} />
    ) : (
      <Image src={src} alt={alt} widths={widths} sizes={sizes} loading="lazy" class="guide-figure__img" />
    )}
  </div>
  )}
  {caption && <figcaption class="guide-figure__cap">{caption}</figcaption>}
  {lightbox && (
    <dialog class="guide-lb" data-lb aria-label={alt}>
      <button type="button" class="guide-lb__close" data-lb-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
      </button>
      <div class="guide-lb__stage">
        <Image src={src} alt={alt} widths={[800, 1200, 1600, 2000]} sizes="min(92vw, 1100px)" loading="lazy" class="guide-lb__img" />
        {caption && <p class="guide-lb__cap">{caption}</p>}
      </div>
    </dialog>
  )}
</figure>

{lightbox && (
  <script>
    // Lightbox: each [data-lb-open] button opens the <dialog data-lb> inside the
    // same <figure>. Native showModal gives Esc + focus trap; a click on the
    // backdrop (the dialog element itself, not its children) closes. Wired
    // per pageview via onPageReady; buttons mark themselves so client-side
    // navigation doesn't double-bind.
    import { onPageReady } from '@/lib/vt';
    onPageReady(() => {
      document.querySelectorAll<HTMLButtonElement>('[data-lb-open]:not([data-lb-wired])').forEach((btn) => {
        btn.dataset.lbWired = '1';
        const fig = btn.closest('figure');
        const dlg = fig?.querySelector<HTMLDialogElement>('dialog[data-lb]');
        if (!dlg || typeof dlg.showModal !== 'function') return;
        const close = () => dlg.close();
        btn.addEventListener('click', () => { dlg.showModal(); });
        dlg.querySelector('[data-lb-close]')?.addEventListener('click', close);
        dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
      });
    });
  </script>
)}

{parallax && (
  <script>
    // Drift each [data-parallax] image slower than the scroll. One rAF loop for
    // all instances. The image overscans the frame (height > 100%); we translate
    // it within that overscan so it always covers. Skipped under reduced-motion
    // (CSS resets it to a static cover image). Items re-collect per pageview
    // (onPageReady) so client-side navigation picks up the new page's images;
    // the window listeners wire once per session.
    import { onPageReady } from '@/lib/vt';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let items: { img: HTMLImageElement; frame: HTMLElement }[] = [];
    let wired = false;
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      for (const { img, frame } of items) {
        if (!frame.isConnected) continue;
        const r = frame.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) continue;
        const extra = img.offsetHeight - frame.offsetHeight; // overscan to play with
        // 0 as the frame enters from the bottom → 1 as it exits the top.
        const prog = (vh - r.top) / (vh + r.height);
        img.style.transform = `translate3d(0, ${(-extra * prog).toFixed(1)}px, 0)`;
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    onPageReady(() => {
      const imgs = Array.from(document.querySelectorAll<HTMLImageElement>('[data-parallax]'));
      if (!imgs.length || reduce) { items = []; return; }
      items = imgs.map((img) => ({ img, frame: img.parentElement as HTMLElement }));
      if (!wired) {
        wired = true;
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }
      update();
    });
  </script>
)}

<style>
  .guide-figure { margin: 2rem 0; }
  .guide-figure__frame {
    overflow: hidden; border-radius: var(--radius);
    box-shadow: var(--shadow-card); background: rgba(45, 106, 79, 0.06);
    position: relative;
  }
  .guide-figure__frame :global(.guide-figure__img),
  .guide-figure__frame :global(.kb) { width: 100%; height: 100%; display: block; }
  .guide-figure__frame :global(.guide-figure__img) { object-fit: cover; }
  .guide-figure__zoom { padding: 0; border: 0; width: 100%; cursor: zoom-in; font: inherit; }
  .guide-figure__zoom:focus-visible { outline: 2px solid var(--green-accent); outline-offset: 3px; }

  /* Lightbox dialog: dark green backdrop (press page's), image fit to viewport. */
  .guide-lb { border: 0; padding: 0; background: transparent; max-width: none; max-height: none; width: 100vw; height: 100dvh; }
  .guide-lb::backdrop { background: rgba(10, 25, 18, 0.93); }
  .guide-lb[open] { display: grid; place-items: center; cursor: zoom-out; }
  .guide-lb__stage { pointer-events: none; display: grid; justify-items: center; gap: 0.7rem; padding: 1rem; }
  .guide-lb :global(.guide-lb__img) { display: block; width: auto; height: auto; max-height: 84dvh; max-width: min(92vw, 1100px); border-radius: var(--radius); box-shadow: 0 24px 60px rgba(0,0,0,0.5); }
  .guide-lb__cap { margin: 0; color: rgba(255,255,255,0.78); font-size: 0.85rem; line-height: 1.5; text-align: center; max-width: 40rem; }
  .guide-lb__close {
    position: fixed; top: 1rem; right: 1rem; display: grid; place-items: center;
    width: 2.9rem; height: 2.9rem; border: 0; border-radius: 50%;
    background: rgba(255,255,255,0.14); color: #fff; cursor: pointer; transition: background 0.15s ease;
  }
  .guide-lb__close:hover { background: rgba(255,255,255,0.28); }
  .guide-lb__close:focus-visible { outline: 2px solid var(--green-accent); outline-offset: 2px; }
  .guide-figure__cap {
    margin-top: 0.6rem; font-size: 0.82rem; color: var(--muted);
    line-height: 1.5; text-align: center;
  }

  /* Parallax: the image overscans the frame and is translated by the script. */
  .guide-figure--parallax .guide-figure__frame :global(.guide-figure__img--parallax) {
    position: absolute; left: 0; top: 0; width: 100%; height: 124%;
    object-fit: cover; will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .guide-figure--parallax .guide-figure__frame :global(.guide-figure__img--parallax) {
      position: absolute; height: 100%; transform: none !important;
    }
  }

  /* Float: a small inline figure the prose wraps around. Desktop-only — on
     narrow viewports it unfloats to a modest centered figure (wrap needs a
     wide column to breathe). */
  @media (min-width: 641px) {
    .guide-figure--float { width: 14rem; margin-top: 0.3rem; }
    .guide-figure--float-right { float: right; margin-left: 1.4rem; margin-bottom: 0.9rem; }
    .guide-figure--float-left { float: left; margin-right: 1.4rem; margin-bottom: 0.9rem; }
  }
  @media (max-width: 640px) {
    .guide-figure--float { max-width: 16rem; margin-inline: auto; }
  }

  /* Wide banner: full-width (capped at --maxw, no scrollbar), sitting ABOVE the
     sticky TOC (z-index:1) so the TOC flows behind it while on screen. */
  .guide-figure--wide {
    position: relative;
    z-index: 2;
    width: min(100vw, var(--maxw));
    margin-inline: calc(50% - min(50vw, var(--maxw) / 2));
  }
  @media (max-width: 600px) {
    .guide-figure--wide .guide-figure__frame { border-radius: 0; }
  }

  /* Reveal-on-scroll (observer in GuideLayout toggles .is-in). */
  .guide-figure[data-reveal] { opacity: 0; transform: translateY(14px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .guide-figure[data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .guide-figure[data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>
