---
// HouseGrid — the season's haunted-house lineup in Lanyard's own colorized
// house art, styled to rhyme with the app's House Tracker: every tile wears
// the dashed "unstamped" frame, waiting to be walked. Houses arrive in
// location GROUPS (front / mid / back of park, Dan's call 2026-08-25) so the
// grid doubles as a where-they-load map; each group carries a label and an
// optional entrance-notes line. This is the guide→app continuity beat.
// Names come from the app's data (perks.json) via the MDX — never retyped
// from memory. Art is ours; no official key art, ever.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface House {
  name: string;
  image: ImageMetadata;
  alt: string;
  /** Silhouette stamp SVG (unit-square viewBox, single path) used as a CSS
   * mask. Default state on hover-capable devices: the stamp; hovering
   * "stamps" the tile — the full art fades in. Touch devices get the art
   * directly (most of the audience; the reveal is a pointer nicety). */
  stamp?: ImageMetadata;
  /** 2 pm Stay & Scream early house — wears HHN orange (stamp, frame, and a
   * "2 pm" badge that survives the hover reveal) instead of Lanyard green. */
  early?: boolean;
}
interface HouseGroup {
  label: string;
  /** Entrance/location notes, rendered under the label. */
  note?: string;
  houses: House[];
}
interface Props {
  groups: HouseGroup[];
  caption?: string;
}
const { groups, caption } = Astro.props;
---
<figure class="housegrid" data-reveal>
  {groups.map((g) => (
    <section class="housegrid__group">
      <h4 class="housegrid__label">{g.label}</h4>
      {g.note && <p class="housegrid__note">{g.note}</p>}
      <ul class="housegrid__list">
        {g.houses.map((h) => (
          <li class:list={['housegrid__tile', { 'housegrid__tile--early': !!h.early }]}>
            <div class:list={['housegrid__stamp', { 'housegrid__stamp--reveal': !!h.stamp }]}>
              {h.early && <span class="housegrid__early">2 pm</span>}
              {h.stamp && (
                <span
                  class="housegrid__silhouette"
                  style={`-webkit-mask-image: url(${h.stamp.src}); mask-image: url(${h.stamp.src});`}
                  aria-hidden="true"
                />
              )}
              <Image
                src={h.image}
                alt={h.alt}
                widths={[240, 400, 800]}
                sizes="(min-width: 960px) 140px, (min-width: 640px) 25vw, 40vw"
                loading="lazy"
                class="housegrid__art"
              />
            </div>
            <p class="housegrid__name">{h.name}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
  {caption && <figcaption class="housegrid__cap">{caption}</figcaption>}
</figure>

<script>
  // Tap-to-stamp: on touch devices (no hover) a tap toggles the reveal, the
  // same gesture as stamping a house in the app. Desktop clicks toggle too —
  // harmless alongside hover. Tiles re-collect per pageview for client-side
  // navigation; each tile is wired at most once.
  import { onPageReady } from '@/lib/vt';
  onPageReady(() => {
    document.querySelectorAll<HTMLElement>('.housegrid__tile').forEach((tile) => {
      if (tile.dataset.stampWired || !tile.querySelector('.housegrid__stamp--reveal')) return;
      tile.dataset.stampWired = '1';
      tile.addEventListener('click', () => tile.classList.toggle('is-stamped'));
    });
  });
</script>

<style>
  .housegrid { margin: 2.2rem 0; }
  .housegrid__group { margin-top: 1.6rem; }
  .housegrid__group:first-child { margin-top: 0; }
  .housegrid__label {
    margin: 0; font-family: var(--font-display); font-weight: 800;
    font-size: 1rem; color: var(--green-primary);
  }
  .housegrid__note {
    margin: 0.3rem 0 0; font-size: 0.88rem; color: var(--muted); line-height: 1.55;
  }
  .housegrid__list {
    list-style: none; margin: 0.9rem 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.9rem;
  }
  .housegrid__tile { flex: 1 1 8rem; max-width: 10.5rem; text-align: center; }
  /* The unstamped frame from the app's House Tracker: dashed, waiting. */
  .housegrid__stamp {
    position: relative;
    border: 2px dashed rgba(45, 106, 79, 0.35);
    border-radius: var(--radius);
    padding: 0.35rem;
    background: #fff;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .housegrid__tile:hover .housegrid__stamp {
    border-color: var(--green-accent); transform: translateY(-2px);
  }
  .housegrid__art {
    width: 100%; height: auto; aspect-ratio: 1; object-fit: cover;
    border-radius: calc(var(--radius) - 4px); display: block;
  }

  /* ---- 2 pm Stay & Scream houses wear HHN orange ---- */
  .housegrid__tile--early .housegrid__stamp { border-color: rgba(234, 115, 23, 0.55); }
  .housegrid__tile--early:hover .housegrid__stamp { border-color: rgba(234, 115, 23, 0.9); }
  .housegrid__tile--early .housegrid__silhouette { background: #ea7317; }
  .housegrid__early {
    position: absolute; top: 0.55rem; right: 0.55rem; z-index: 2;
    padding: 0.08rem 0.42rem; border-radius: 999px;
    background: rgba(234, 115, 23, 0.95); color: #fff;
    font-family: var(--font-display); font-weight: 800; font-size: 0.62rem;
    letter-spacing: 0.04em;
  }

  /* ---- Stamp-until-revealed (hover on pointer devices, tap on touch) ---- */
  .housegrid__stamp--reveal { position: relative; }
  .housegrid__silhouette {
    display: block;
    position: absolute; inset: 0.35rem;
    background: var(--green-primary); opacity: 0.75;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    -webkit-mask-position: center; mask-position: center;
    -webkit-mask-size: 78%; mask-size: 78%;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .housegrid__stamp--reveal .housegrid__art { opacity: 0; transition: opacity 0.25s ease; }
  /* Hover stamps it in (pointer devices)... */
  @media (hover: hover) {
    .housegrid__tile:hover .housegrid__stamp--reveal .housegrid__art { opacity: 1; }
    .housegrid__tile:hover .housegrid__stamp--reveal .housegrid__silhouette { opacity: 0; }
  }
  /* ...and a tap stamps it on any device (the House Tracker gesture). */
  .housegrid__tile.is-stamped .housegrid__stamp--reveal .housegrid__art { opacity: 1; }
  .housegrid__tile.is-stamped .housegrid__stamp--reveal .housegrid__silhouette { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .housegrid__silhouette,
    .housegrid__stamp--reveal .housegrid__art { transition: none; }
  }
  .housegrid__name {
    margin: 0.5rem 0 0; font-family: var(--font-display); font-weight: 700;
    font-size: 0.78rem; line-height: 1.25; color: var(--ink);
  }
  .housegrid__cap {
    margin-top: 1.2rem; font-size: 0.82rem; color: var(--muted);
    line-height: 1.5; text-align: center;
  }

  /* Reveal-on-scroll (observer in GuideLayout toggles .is-in). */
  .housegrid[data-reveal] { opacity: 0; transform: translateY(14px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .housegrid[data-reveal].is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .housegrid[data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>
